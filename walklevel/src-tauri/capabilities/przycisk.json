{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "przycisk",
  "description": "Pływający przycisk: telemetria, wycinek bubble, przeciąganie okna i komendy bubble_*.",
  "windows": [
    "przycisk"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-bubble-click",
    "allow-bubble-open",
    "allow-bubble-drag-start",
    "allow-bubble-drag-end",
    "allow-app-snapshot",
    "allow-ui-ready"
  ]
}
