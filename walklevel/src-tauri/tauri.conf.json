{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WalkLevel",
  "version": "0.6.2",
  "identifier": "pl.damnit.walklevel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost http://ikona.localhost ikona:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/bieznia.ico",
      "icons/bieznia.png"
    ]
  }
}
